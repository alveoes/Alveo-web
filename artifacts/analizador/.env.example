# Copia este archivo como variables de entorno del servidor (Secrets en Replit). Nunca en el navegador.

# --- Google Places API (New) ---
GOOGLE_PLACES_API_KEY=
# Análisis de Google no cacheados por día (cada uno = 1 Text Search + 1 Place Details como máximo)
GOOGLE_DAILY_BUDGET=30

# --- Instagram Graph API (Business Discovery) ---
META_IG_USER_ID=
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v25.0
INSTAGRAM_DAILY_BUDGET=150

# --- Servidor ---
PORT=8090
BASE_PATH=/analiza-tu-negocio
# 1 solo si hay un proxy de confianza delante (Replit, Nginx, Cloudflare)
TRUST_PROXY=0
CACHE_TTL_HOURS=24
RATE_LIMIT_10MIN=5
RATE_LIMIT_DAILY=20
MAX_CONCURRENT_ANALYSES=4
UPSTREAM_TIMEOUT_MS=8000

# --- Registro interno de análisis (evidencias + versión de rúbrica) ---
AUDIT_LOG=1
AUDIT_LOG_FILE=
AUDIT_RETENTION_DAYS=365
